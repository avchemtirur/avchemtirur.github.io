<!DOCTYPE html>
<html lang="ml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>H4 ShieldX - AV Chem Official</title>
    <style>
        :root {
            --h4-purple: #9c2063;
            --h4-yellow: #fdb913;
            --text-dark: #2d2d2d;
        }

        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            margin: 0; padding: 0; background-color: #fff;
            color: var(--text-dark); line-height: 1.6;
        }

        /* Header & Logo */
        header {
            background: #fff;
            padding: 15px;
            text-align: center;
            border-bottom: 5px solid var(--h4-yellow);
            position: sticky; top: 0; z-index: 1000;
        }

        .logo { max-width: 180px; }

        /* Hero Section */
        .hero {
            background: linear-gradient(rgba(156, 32, 99, 0.9), rgba(156, 32, 99, 0.8)), url('3d-floor-2.jpg');
            background-size: cover; background-position: center;
            color: white; padding: 60px 20px; text-align: center;
        }

        .hero h1 { font-size: 2.5rem; margin: 0; color: var(--h4-yellow); }
        .hero p { font-size: 1.2rem; max-width: 800px; margin: 20px auto; }

        .container { max-width: 1100px; margin: 0 auto; padding: 20px; }

        /* Feature Icons (Style from your image) */
        .feature-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 20px; margin: 40px 0;
        }

        .feature-box {
            border: 2px solid #eee; border-radius: 15px; padding: 20px;
            text-align: center; transition: 0.3s;
        }

        .feature-box:hover { border-color: var(--h4-purple); transform: translateY(-5px); }
        .feature-box img { width: 60px; height: 60px; margin-bottom: 10px; }
        .feature-box h4 { margin: 5px 0; color: var(--h4-purple); }

        /* 3D Work Gallery */
        .gallery-title {
            text-align: center; border-bottom: 3px solid var(--h4-yellow);
            display: table; margin: 40px auto; padding-bottom: 10px;
        }

        .gallery {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 15px;
        }

        .gallery-item {
            position: relative; overflow: hidden; border-radius: 12px; height: 250px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: 0.5s; }
        .gallery-item:hover img { transform: scale(1.1); }
        .gallery-label {
            position: absolute; bottom: 0; background: rgba(156, 32, 99, 0.8);
            color: white; width: 100%; padding: 10px; text-align: center;
        }

        /* Order Form Section */
        .order-section {
            background: #fdf7ec; border: 3px solid var(--h4-purple);
            border-radius: 20px; padding: 30px; margin-top: 50px;
        }

        .form-group { margin-bottom: 15px; }
        input, select, textarea {
            width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 8px; font-size: 16px;
        }

        .btn-submit {
            background: var(--h4-purple); color: white; border: none;
            padding: 15px 30px; border-radius: 10px; font-weight: bold;
            width: 100%; cursor: pointer; font-size: 18px;
        }

        footer {
            background: var(--h4-purple); color: white;
            text-align: center; padding: 40px 20px; margin-top: 60px;
        }

        @media (max-width: 600px) {
            .hero h1 { font-size: 1.8rem; }
            .gallery { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <header>
        <img src="h4logo.png" alt="H4 Logo" class="logo">
    </header>

    <div class="hero">
        <h1>H4 SHIELDX</h1>
        <p>കേരളത്തിൽ ആദ്യമായി: ടൈലിനും വാട്ടർപ്രൂഫിംഗിനും അപ്പുറം ഒരു ദൃശ്യവിസ്മയം! നിങ്ങളുടെ തറയിൽ കടലും തിരമാലകളും ജീവൻ വെക്കുന്നു.</p>
    </div>

    <div class="container">
        
        <div class="feature-grid">
            <div class="feature-box">
                <img src="https://cdn-icons-png.flaticon.com/512/3105/3105807.png">
                <h4>100% Waterproof</h4>
            </div>
            <div class="feature-box">
                <img src="https://cdn-icons-png.flaticon.com/512/1598/1598238.png">
                <h4>Crack Resistant</h4>
            </div>
            <div class="feature-box">
                <img src="https://cdn-icons-png.flaticon.com/512/2163/2163350.png">
                <h4>Jointless Finish</h4>
            </div>
            <div class="feature-box">
                <img src="https://cdn-icons-png.flaticon.com/512/916/916771.png">
                <h4>Life-time Bond</h4>
            </div>
        </div>

        <h2 class="gallery-title">ഞങ്ങളുടെ ഏറ്റവും പുതിയ വർക്കുകൾ</h2>
        
        <div class="gallery">
            <div class="gallery-item">
                <img src="3d-floor-1.jpg" alt="3D Floor">
                <div class="gallery-label">3D Ocean Bathroom</div>
            </div>
            <div class="gallery-item">
                <img src="3d-floor-2.jpg" alt="3D Floor">
                <div class="gallery-label">Beach Effect Flooring</div>
            </div>
            <div class="gallery-item">
                <img src="3d-floor-3.jpg" alt="3D Floor">
                <div class="gallery-label">Dolphin 3D Art</div>
            </div>
            <div class="gallery-item">
                <img src="jointless-1.jpg" alt="Jointless">
                <div class="gallery-label">Premium Jointless Finish</div>
            </div>
            <div class="gallery-item">
                <img src="waterproof-1.jpg" alt="Waterproof">
                <div class="gallery-label">Roof Waterproofing</div>
            </div>
            <div class="gallery-item">
                <img src="finish-1.jpg" alt="Finish">
                <div class="gallery-label">H4 ShieldX Glossy Finish</div>
            </div>
        </div>

        <div class="order-section">
            <h2 style="text-align: center; color: var(--h4-purple);">Book Free Demo / Visit</h2>
            <form id="orderForm">
                <div class="form-group">
                    <input type="text" id="name" placeholder="പേര് (Name)" required>
                </div>
                <div class="form-group">
                    <input type="tel" id="mobile" placeholder="മൊബൈൽ നമ്പർ (10 Digit)" required>
                </div>
                <div class="form-group">
                    <input type="text" id="location" placeholder="സ്ഥലം (Location)" required>
                </div>
                <div class="form-group">
                    <select id="workType">
                        <option value="3D Flooring">3D Epoxy Flooring</option>
                        <option value="Jointless">Jointless Tile Bond</option>
                        <option value="Waterproof">100% Waterproofing</option>
                    </select>
                </div>
                <button type="button" class="btn-submit" onclick="sendToWhatsApp()">Book My Demo on WhatsApp</button>
            </form>
        </div>
    </div>

    <footer>
        <h3>AV Chem Chemical & Manufacturing</h3>
        <p>Mukkilapeedika, Malappuram | +91 97458 38382</p>
        <p>© 2025 H4 ShieldX. All rights reserved.</p>
    </footer>

    <script>
        function sendToWhatsApp() {
            const name = document.getElementById('name').value;
            const mobile = document.getElementById('mobile').value;
            const location = document.getElementById('location').value;
            const work = document.getElementById('workType').value;

            if(!name || !mobile || !location) {
                alert("ദയവായി എല്ലാ വിവരങ്ങളും നൽകുക.");
                return;
            }

            const message = `*H4 SHIELDX NEW REQUEST*%0A%0A*Name:* ${name}%0A*Mobile:* ${mobile}%0A*Location:* ${location}%0A*Work:* ${work}`;
            window.open(`https://wa.me/919745838382?text=${message}`);
        }
    </script>
</body>
</html>

