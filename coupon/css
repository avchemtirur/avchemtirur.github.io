/* ============================================================
   H4 COUPON — Material Design 3 Design Tokens
   Shared across the entire /coupon module. Do not duplicate
   color/shape/typography values anywhere else — reference
   these custom properties instead.
   ============================================================ */
:root{
  /* ---- Brand seed color (H4 gold, matches parent ERP identity) ---- */
  --md-seed:#C9962B;

  /* ---- Core color roles (Material 3, light scheme) ---- */
  --md-primary:#8A5B00;
  --md-on-primary:#FFFFFF;
  --md-primary-container:#FFDDA8;
  --md-on-primary-container:#2B1700;

  --md-secondary:#6F5B3E;
  --md-on-secondary:#FFFFFF;
  --md-secondary-container:#FADEB3;
  --md-on-secondary-container:#271904;

  --md-tertiary:#4C662B;
  --md-on-tertiary:#FFFFFF;
  --md-tertiary-container:#CDEDA3;
  --md-on-tertiary-container:#102000;

  --md-error:#BA1A1A;
  --md-on-error:#FFFFFF;
  --md-error-container:#FFDAD6;
  --md-on-error-container:#410002;

  --md-success:#2E7D32;
  --md-on-success:#FFFFFF;

  --md-surface:#FFF8F1;
  --md-surface-dim:#E0D9CB;
  --md-surface-bright:#FFF8F1;
  --md-surface-container-lowest:#FFFFFF;
  --md-surface-container-low:#FAF1E4;
  --md-surface-container:#F4EBDE;
  --md-surface-container-high:#EEE5D8;
  --md-surface-container-highest:#E9E0D3;
  --md-on-surface:#1F1B13;
  --md-on-surface-variant:#4F4539;

  --md-outline:#817567;
  --md-outline-variant:#D3C5B4;

  --md-inverse-surface:#342F27;
  --md-inverse-on-surface:#F9EFE1;
  --md-inverse-primary:#FFB945;

  --md-scrim:#000000;
  --md-shadow:#000000;

  /* ---- Shape scale ---- */
  --md-shape-xs:4px;
  --md-shape-sm:8px;
  --md-shape-md:12px;
  --md-shape-lg:16px;
  --md-shape-xl:28px;
  --md-shape-full:999px;

  /* ---- Elevation (Material 3 shadow tiers) ---- */
  --md-elev-0:none;
  --md-elev-1:0 1px 2px rgba(0,0,0,.16), 0 1px 3px 1px rgba(0,0,0,.08);
  --md-elev-2:0 1px 2px rgba(0,0,0,.20), 0 2px 6px 2px rgba(0,0,0,.10);
  --md-elev-3:0 1px 3px rgba(0,0,0,.22), 0 4px 8px 3px rgba(0,0,0,.12);

  /* ---- Typography scale ---- */
  --md-font: 'Roboto', 'Inter', system-ui, -apple-system, sans-serif;
  --md-display-size:34px;
  --md-headline-size:24px;
  --md-title-size:18px;
  --md-title-sm-size:14px;
  --md-body-size:15px;
  --md-body-sm-size:13px;
  --md-label-size:12px;

  /* ---- Motion ---- */
  --md-motion-fast:120ms;
  --md-motion-med:220ms;
  --md-motion-emphasis:cubic-bezier(.2,0,0,1);

  /* ---- Layout ---- */
  --md-topbar-h:60px;
  --md-bottomnav-h:68px;
  --md-max-width:520px; /* mobile-first single column, capped for tablets */
}

/* ---- Dark scheme (auto via prefers-color-scheme; toggled manually too) ---- */
[data-theme="dark"]{
  --md-primary:#FFB945;
  --md-on-primary:#472A00;
  --md-primary-container:#673F00;
  --md-on-primary-container:#FFDDA8;

  --md-secondary:#DDC2A0;
  --md-on-secondary:#3E2E15;
  --md-secondary-container:#56422A;
  --md-on-secondary-container:#FADEB3;

  --md-tertiary:#B1D18A;
  --md-on-tertiary:#1F3701;
  --md-tertiary-container:#354E16;
  --md-on-tertiary-container:#CDEDA3;

  --md-error:#FFB4AB;
  --md-on-error:#690005;
  --md-error-container:#93000A;
  --md-on-error-container:#FFDAD6;

  --md-surface:#17130C;
  --md-surface-dim:#17130C;
  --md-surface-bright:#3E382F;
  --md-surface-container-lowest:#120E08;
  --md-surface-container-low:#1F1B13;
  --md-surface-container:#231F17;
  --md-surface-container-high:#2E2921;
  --md-surface-container-highest:#39342B;
  --md-on-surface:#EBE1D4;
  --md-on-surface-variant:#D3C5B4;

  --md-outline:#9C8F80;
  --md-outline-variant:#4F4539;

  --md-inverse-surface:#EBE1D4;
  --md-inverse-on-surface:#342F27;
  --md-inverse-primary:#8A5B00;
}
